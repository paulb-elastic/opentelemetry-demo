# Change UNIQUE_NAME once; it is substituted into ENVIRONMENT, DEPLOYMENT_ENVIRONMENT, and OTEL_RESOURCE_ATTRIBUTES.

########################################################
## MAIN CONFIG PARAMS
########################################################
UNIQUE_NAME=example_parallel        # The unique name of this project (ensure there is a corresponding .env.UNIQUE_NAME file)
                                    #   can then start the oTel demo with: make start environment=UNIQUE_NAME
UNIQUE_PORT_OFFSET=0                # Offset for ports (e.g. 8080, 10000, 9090) of this project's components from 8080, 10000, 9090
ELASTICSEARCH_ENDPOINT=""
ELASTICSEARCH_API_KEY=""
# Embrace RUM SDK — set this to your App ID from https://dash.embrace.io
NEXT_PUBLIC_EMBRACE_APP_ID=EMBRACE_APP_ID_HERE
# Embrace → Elastic mOTLP Gateway (src/otel-collector/otelcol-embrace-gateway-config.yaml)
# Shared secret sent by Embrace as a bearer token. Set to any strong random string
# (e.g. openssl rand -hex 32), then enter the same value as the "Secret Token" in
# the Embrace dashboard Elastic destination config.
EMBRACE_INGEST_TOKEN=change-me
# Elastic Cloud Managed OTLP endpoint (.ingest URL, NOT the .apm URL).
# Find it: Elastic Cloud > Manage project > Application endpoints > Managed OTLP
MOTLP_ENDPOINT=https://<your-deployment>.ingest.elastic.cloud
# ELASTICSEARCH_API_KEY (above) is reused as the API key for the mOTLP endpoint.
########################################################
########################################################

ENVIRONMENT=${UNIQUE_NAME}
DEPLOYMENT_ENVIRONMENT=${UNIQUE_NAME}
ENVOY_PORT=808${UNIQUE_PORT_OFFSET}
ENVOY_ADMIN_PORT=1000${UNIQUE_PORT_OFFSET}
PROMETHEUS_PORT=909${UNIQUE_PORT_OFFSET}
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=${IMAGE_VERSION},deployment.environment=${UNIQUE_NAME}
